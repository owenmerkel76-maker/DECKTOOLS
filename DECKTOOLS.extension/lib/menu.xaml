<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DECKTOOLS | Studio"
 Width="690" Height="690" WindowStartupLocation="CenterScreen" Background="#F4F5F3">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD5CF"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#28372E"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="DECKTOOLS" FontSize="30" FontWeight="Bold"/>
  <TextBlock Text="Choose a tool below. Hover over ribbon buttons for more instructions." FontSize="15" TextWrapping="Wrap" Margin="0,8,0,16"/>
  <Border Background="#E5EEE7" Padding="14" Margin="0,0,0,18"><StackPanel>
   <TextBlock Text="Your first deck" FontSize="16" FontWeight="Bold"/>
   <TextBlock Text="1. Create a flat rectangular Floor as the footprint.&#10;2. Select that Floor and choose Deck Designer below.&#10;3. Review the settings and quantities, then generate and open a 3D view." TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Button Tag="layout" Click="on_action"><StackPanel><TextBlock Text="Deck Designer — create a complete deck" FontSize="19" FontWeight="Bold"/><TextBlock Text="Start with a selected rectangular Floor. Creates boards, optional picture-frame borders, and clips, plus cutting schedules and purchase estimates. Rerun on the same Floor to replace its layout." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
  <Button Tag="materials" Click="on_action"><StackPanel><TextBlock Text="Deck Materials — make a finish" FontSize="19" FontWeight="Bold"/><TextBlock Text="Create a named project material using a color, texture, and optional bump map. Then select it in Deck Designer's Materials tab for the field or border; creating it alone does not apply it." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
  <Button Tag="board" Click="on_action"><StackPanel><TextBlock Text="Trex Board Builder — make one board family" FontSize="17" FontWeight="Bold"/><TextBlock Text="Save an individual reusable .rfa with a chosen width and adjustable length. Optional: Deck Designer creates its own boards for a complete deck." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
  <Button Tag="library" Click="on_action"><StackPanel><TextBlock Text="Manufacturer website / BIM resources" FontSize="17" FontWeight="Bold"/><TextBlock Text="Open Trex's website to find supplied maps or material libraries. Download/import them yourself, then choose the material in Deck Designer." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
  <TextBlock Text="Manage a generated deck" FontSize="17" FontWeight="Bold" Margin="0,14,0,12"/>
  <TextBlock Text="Use these after generating a deck. Select its footprint Floor for deck-specific commands." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <UniformGrid Columns="2">
   <Button Tag="inspect" Click="on_action" Margin="0,0,8,10"><StackPanel><TextBlock Text="Inspect quantities" FontWeight="Bold"/><TextBlock Text="Count the selected Floor's existing field boards, border cuts, and clips." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
   <Button Tag="select" Click="on_action"><StackPanel><TextBlock Text="Select generated elements" FontWeight="Bold"/><TextBlock Text="Select that Floor's boards and clips together to inspect their properties." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
   <Button Tag="reports" Click="on_action" Margin="0,0,8,10"><StackPanel><TextBlock Text="Open CSV reports" FontWeight="Bold"/><TextBlock Text="Open existing cut lists, stock schedules, and material estimates in File Explorer." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
   <Button Tag="remove" Click="on_action"><StackPanel><TextBlock Text="Remove generated deck…" FontWeight="Bold"/><TextBlock Text="After confirmation, delete that Floor's generated boards and clips. Keep the footprint Floor." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Button>
  </UniformGrid>
  <TextBlock Text="Rectangular floors • Revit 2025+ • field and border materials" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
