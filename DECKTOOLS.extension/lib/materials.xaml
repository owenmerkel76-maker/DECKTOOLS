<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DECKTOOLS | Materials studio"
 Width="740" Height="780" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F4F5F3">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,4"/><Setter Property="Foreground" Value="#28372E"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Deck materials" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="Create a field or border finish with a color, image texture, and bump map." TextWrapping="Wrap"/>
   <TextBlock Text="New material name"/><TextBox x:Name="material_name" Text="DT Custom Decking"/>
   <TextBlock Text="Appearance template / imported manufacturer material"/><ComboBox x:Name="source" Padding="7"/>
   <TextBlock Text="Color"/><DockPanel><Button DockPanel.Dock="Right" Content="Pick color" Click="on_color"/><TextBox x:Name="color" Text="#805F49"/></DockPanel>
   <TextBlock Text="Color texture (optional)"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="on_texture"/><TextBox x:Name="texture"/></DockPanel>
   <TextBlock Text="Grayscale bump / height map (optional)"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="on_bump"/><TextBox x:Name="bump"/></DockPanel>
   <TextBlock Text="Bump strength (0 to 1)"/><TextBox x:Name="bump_amount" Text="0.3"/>
   <CheckBox x:Name="clear_maps" Content="Remove inherited maps when no replacement file is selected" Margin="0,12,0,0"/>
   <TextBlock Text="Blank map paths preserve maps from a source material unless the box above is checked. Source assets are copied, so other project materials remain unchanged." TextWrapping="Wrap"/>
   <GroupBox Header="Manufacturer resources" Margin="0,22,0,12"><StackPanel Margin="14">
    <Button Content="Open Trex website / find BIM resources" Click="on_library" HorizontalAlignment="Left"/>
    <TextBlock Text="Download the manufacturer's supplied materials or image maps. For an Autodesk material library (.adsklib), use Revit Material Browser to import a project material, then select it above or directly in Deck Designer." TextWrapping="Wrap"/>
    <TextBlock Text="This is a browser-and-file import workflow; there is no automatic catalogue sync. A grayscale height map is different from a normal map. Use manufacturer-provided assets; no bump map is fabricated from a color image." TextWrapping="Wrap"/>
   </StackPanel></GroupBox>
   <TextBlock Text="Color-only materials work in Shaded views. Generic appearance textures/bump maps are for Realistic views and rendering. Verify map scale/orientation in Revit Material Browser; keep source files available." TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Click="on_cancel"/><Button Content="Create material" Click="on_create" Background="#275840" Foreground="White"/></StackPanel>
 </Grid>
</Window>
